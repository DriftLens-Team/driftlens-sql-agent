{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SQL agent - Quick start (auto)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/start.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {"python": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.vscode/debug.env",
      "env": {"PYTHONUTF8": "1"}
    }
  ]
}
